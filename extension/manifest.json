{
  "manifest_version": 3,
  "name": "Tab bridge",
  "version": "0.3.0",
  "description": "Lets the local tabs CLI manage tabs and bookmarks.",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": ["tabs", "tabGroups", "bookmarks", "sessions", "nativeMessaging", "alarms", "storage", "identity", "identity.email"],
  "action": { "default_title": "Tab bridge" },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["no-autoplay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": { "service_worker": "background.js" }
}
